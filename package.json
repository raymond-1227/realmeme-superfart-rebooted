{
  "name": "realmeme-superfart",
  "version": "2.0.0",
  "description": "The Discord bot for r/realme Community Discord server.",
  "homepage": "https://github.com/raymond-1227/realmeme-superfart-rebooted",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "clean": "node -e \"import('node:fs').then((fs) => fs.rmSync('dist', { recursive: true, force: true }))\"",
    "build": "npm run clean && tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "deploy": "npm run build && node dist/deploy.js",
    "undeploy": "npm run build && node dist/undeploy.js",
    "test": "npm run typecheck"
  },
  "author": "Raymond Hsu",
  "license": "MIT",
  "dependencies": {
    "@discordjs/opus": "^0.11.0",
    "@discordjs/voice": "^0.19.2",
    "@google/genai": "^3.3.0",
    "axios": "^1.21.1",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10",
    "ffmpeg-static": "^5.3.0",
    "libsodium-wrappers": "^0.8.4",
    "ms": "^2.1.3",
    "opusscript": "^0.1.1"
  },
  "allowScripts": {
    "ffmpeg-static": true,
    "@discordjs/opus@0.11.0": true,
    "protobufjs@7.6.6": true
  },
  "devDependencies": {
    "@types/ms": "^2.1.0",
    "@types/node": "^26.6.11",
    "typescript": "^7.0.2"
  }
}
